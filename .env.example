DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5432/agent_coordination
TEST_DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5432/agent_coordination_test
SQL_ECHO=false
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Local runs use a deterministic fake provider by default.
INFERENCE_PROVIDER=fake
INFERENCE_MODEL=openai/gpt-oss-20b
INFERENCE_BASE_URL=https://api.inference.wandb.ai/v1

# Never commit a real key. For W&B either variable works; WANDB_API_KEY is the
# native name and INFERENCE_API_KEY remains the vendor-neutral override.
INFERENCE_API_KEY=
WANDB_API_KEY=

INFERENCE_PROJECT=
INFERENCE_STRUCTURED_OUTPUTS=true

# When provider=wandb, authenticate at startup and load the account's current
# model catalog from GET /v1/models. INFERENCE_MODEL remains the primary prior.
INFERENCE_DISCOVER_MODELS=true
INFERENCE_MODEL_LIMIT=100

WORKER_POLL_INTERVAL_SECONDS=0.5
